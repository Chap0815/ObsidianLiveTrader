# W3-02: Copying this file counts as completed setup. Otherwise the unauthenticated
# /setup save would replace the full .env, so this marker is true and a plain copy
# never opens the setup write path.
SETUP_COMPLETE=true
HOST=127.0.0.1
PORT=8787
# DNS rebinding protection: TrustedHost allowlist is loopback-only (127.0.0.1 /
# localhost / ::1). This is read directly in main.py; add comma-separated hostnames
# only when required. Empty means loopback only.
# TRUSTED_HOSTS_EXTRA=

# mexc | hyperliquid
EXCHANGE=hyperliquid

# --- Hyperliquid (recommended: TESTNET first) ---
HL_TESTNET=true
# Real-funds guard: switching from Testnet to Mainnet (HL_TESTNET=false) while
# trading is armed (TRADING_ENABLED=true) fails closed until explicitly confirmed.
# Set this only when you deliberately intend to trade real funds (see README).
# MAINNET_ACK=false
HL_PRIVATE_KEY=
# Main wallet address if HL_PRIVATE_KEY is an API/agent wallet
HL_ACCOUNT_ADDRESS=
# Optional override (default from HL_TESTNET). If set, its host MUST match
# HL_TESTNET exactly; contradictory mainnet/testnet values abort startup.
# HL_BASE_URL=https://api.hyperliquid-testnet.xyz
# Hard per-request timeout (s) for every Hyperliquid SDK HTTP call. The SDK has
# no timeout by default, so a hung endpoint would block a worker forever. Finite,
# 0.5..120s.
HL_HTTP_TIMEOUT_S=10.0

# --- MEXC (only if EXCHANGE=mexc) ---
MEXC_API_KEY=
MEXC_API_SECRET=
MEXC_BASE_URL=https://api.mexc.com

# LLM: claude (default) | xai | openai (Codex) | ollama (local)
# The provider can be changed in the UI; this is the startup default.
LLM_PROVIDER=claude
# Claude — https://console.anthropic.com/  (keys often start with sk-ant-…)
ANTHROPIC_API_KEY=
# CLAUDE_API_KEY=   # alias for ANTHROPIC_API_KEY
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
# xAI Grok (LLM_PROVIDER=xai) — adjust the model ID here if needed (for example,
# after a 404). Do not switch models blindly; compare proposal quality and hit
# rate in the journal first. The documented default remains grok-4.
XAI_API_KEY=
XAI_MODEL=grok-4
XAI_BASE_URL=https://api.x.ai/v1
# OpenAI Codex (LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
OPENAI_BASE_URL=https://api.openai.com/v1
# Local Ollama (LLM_PROVIDER=ollama) — no key; server must run (`ollama serve`)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.1
LOCAL_API_TOKEN=
# W3-13: leave commented — RISK_PROFILE controls strict_available_margin
# (conservative/balanced=true, free=false). Set only as an intentional override.
# STRICT_AVAILABLE_MARGIN=true
REQUIRE_LOOPBACK_WHEN_ARMED=true
# Risk profile preset: conservative (min_rrr 2.0, strict) | balanced (default,
# min_rrr 1.5) | free (min_rrr 1.5, no equity caps). Only unset fields receive
# preset values; every active MAX_*/MIN_*/STRICT_* line overrides the profile.
# Leave the following lines commented for genuine profile switching.
RISK_PROFILE=balanced
# MAX_LEVERAGE=20
# MAX_RISK_PCT=1.0
# MIN_RRR=1.5
# STRICT_RRR=true
# Hard equity-relative notional cap (fat-finger guard). 0 = off. Leave commented
# so RISK_PROFILE controls it; set only for a deliberate custom override.
# MAX_NOTIONAL_PCT_OF_EQUITY=5000.0
# Manual trigger mode (entry without exchange-side SL/TP). false = fail closed.
ALLOW_MANUAL_TRIGGER=false
# SL verification after placement (the exchange may report triggers with delay).
SL_VERIFY_ATTEMPTS=3
SL_VERIFY_DELAY_S=0.7
# Hyperliquid coins: BTC, ETH, SOL — MEXC: BTC_USDT
DEFAULT_SYMBOL=BTC
PREVIEW_TOKEN_TTL_SECONDS=60
DATABASE_PATH=data/trader.db
TRADING_ENABLED=false
ALLOW_UNPROTECTED_ENTRY=false
RISK_SLIPPAGE_PCT=0.05
MAX_NOTIONAL_USDT=500
MAX_PRICE_DRIFT_PCT=1.0
MARKET_ENTRY_SLIPPAGE_PCT=0.15
ALLOW_CROSS_MARGIN=false
AUTO_FLATTEN_IF_SL_UNVERIFIED=true
# Privacy: opt-in. When true, equity/available margin/open positions are
# sent to the external LLM provider as part of the analysis context.
INCLUDE_ACCOUNT_IN_LLM=false
# Market scanner: lower-cost model screens top coins (one call); detail uses LLM_PROVIDER
SCANNER_MODEL=claude-sonnet-5
SCANNER_MAX_COINS=20

KLINE_LIMIT_HINT=500

# Trade-management layer: break-even monitor and alerts. The monitor runs with the
# process; auto-BE acts ONLY when armed for that position in the dashboard. It is
# Hyperliquid-only and uses the never-unprotected modify-SL path. Without arming,
# only thesis-invalidation and time-stop alerts are emitted.
TM_ENABLED=true
TM_MONITOR_INTERVAL_S=20
TM_BE_TRIGGER_R=1.0
TM_BE_FEE_RT=0.0006
TM_TIME_STOP_HOURS=4.0
TM_TIME_STOP_MIN_R=0.5
# Auto trailing (v2): ATR chandelier stop, opt-in per position, Hyperliquid-only,
# protective direction only. Adds one kline fetch per armed trail position/cycle.
TM_TRAIL_ATR_MULT=2.0
TM_TRAIL_ACTIVATION_R=1.0
TM_TRAIL_ATR_PERIOD=14
TM_TRAIL_ATR_TF=15m
# Minimum trail step as an ATR fraction: modify the SL only when it improves the
# current SL by at least this multiple of ATR. 0 = apply every improvement.
TM_TRAIL_MIN_STEP_ATR=0.25
# Confidence recalibration (advisory): from this sample count per tier, the
# observed Wilson lower-bound hit rate adjusts displayed confidence and sizing.
# It never blocks or changes action, gates, or actual order size.
TM_RECAL_MIN_SAMPLE=20
