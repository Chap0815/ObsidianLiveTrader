# W3-02: Kopie dieser Datei gilt als abgeschlossenes Setup. Die unauth.
# /setup-Speicherung ÜBERSCHREIBT sonst die ganze .env — darum ist dieser
# Marker hier AKTIV (true), damit ein reiner Copy das Setup-Fenster nie öffnet.
SETUP_COMPLETE=true
HOST=127.0.0.1
PORT=8787

# mexc | hyperliquid
EXCHANGE=hyperliquid

# --- Hyperliquid (recommended: TESTNET first) ---
HL_TESTNET=true
# Echtgeld-Schutz: der Wechsel von Testnet auf Mainnet (HL_TESTNET=false) bei
# scharfem Trading (TRADING_ENABLED=true) wird fail-closed abgelehnt, bis du ihn
# hier einmalig ausdrücklich bestätigst. Erst setzen, wenn du wirklich mit echtem
# Kapital handeln willst (siehe README, „Wechsel auf Mainnet“).
# MAINNET_ACK=false
HL_PRIVATE_KEY=
# Main wallet address if HL_PRIVATE_KEY is an API/agent wallet
HL_ACCOUNT_ADDRESS=
# Optional override (default from HL_TESTNET)
# HL_BASE_URL=https://api.hyperliquid-testnet.xyz
# Hard per-request timeout (s) for every Hyperliquid SDK HTTP call. The SDK has
# no timeout by default, so a hung endpoint would block a worker forever. Finite,
# 0.5..120s.
HL_HTTP_TIMEOUT_S=10.0

# --- MEXC (only if EXCHANGE=mexc) ---
MEXC_API_KEY=
MEXC_API_SECRET=
MEXC_BASE_URL=https://contract.mexc.com

# LLM: claude (default) | xai | openai (Codex) | ollama (lokal)
# Hot-Swap im UI möglich; das hier ist der Start-Default.
LLM_PROVIDER=claude
# Claude — https://console.anthropic.com/  (Key oft sk-ant-…)
ANTHROPIC_API_KEY=
# CLAUDE_API_KEY=   # alias für ANTHROPIC_API_KEY
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
# xAI Grok (LLM_PROVIDER=xai) — Modell-ID ggf. anpassen (bei 404 in .env wechseln)
# Kostenhebel: grok-4.3 / grok-4.5 kosten ca. 60-80% weniger pro Token als grok-4.
# Empfehlung: NICHT blind umstellen — erst per Journal-A/B (Proposal-Qualität,
# Trefferquote) verifizieren, dann XAI_MODEL=grok-4.3 (oder grok-4.5) setzen.
# Aktueller dokumentierter Default bleibt grok-4.
XAI_API_KEY=
XAI_MODEL=grok-4
XAI_BASE_URL=https://api.x.ai/v1
# OpenAI Codex (LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
OPENAI_BASE_URL=https://api.openai.com/v1
# Lokales Ollama (LLM_PROVIDER=ollama) — kein Key; Server muss laufen (ollama serve)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.1
LOCAL_API_TOKEN=
# W3-13: auskommentiert lassen — RISK_PROFILE steuert strict_available_margin
# (conservative/balanced=true, free=false). Nur setzen, um das Profil bewusst
# zu überschreiben.
# STRICT_AVAILABLE_MARGIN=true
REQUIRE_LOOPBACK_WHEN_ARMED=true
# Risiko-Profil wählt ein Preset: conservative (min_rrr 2.0, strict) |
# balanced (Default, min_rrr 1.5) | free (min_rrr 1.5, keine Equity-Caps).
# WICHTIG: Nur NICHT gesetzte Felder werden aus dem Preset gefüllt — jede
# hier aktive MAX_*/MIN_*/STRICT_*-Zeile ÜBERSTEUERT das Profil. Für echtes
# Profil-Umschalten die folgenden Zeilen auskommentiert lassen.
RISK_PROFILE=balanced
# MAX_LEVERAGE=20
# MAX_RISK_PCT=1.0
# MIN_RRR=1.5
# STRICT_RRR=true
# Harter equity-relativer Notional-Cap (Fat-Finger-Guard). 0 = aus.
# Auskommentiert lassen, damit RISK_PROFILE den Cap steuert; nur für eigene
# Limits setzen (überschreibt dann das Profil).
# MAX_NOTIONAL_PCT_OF_EQUITY=5000.0
# Aggregat-Risiko (portfolioweiter Cap über alle offenen Positionen) statt nur
# pro Position prüfen. conservative setzt dies automatisch auf true; hier nur
# setzen, um es unabhängig vom Profil zu erzwingen (überschreibt das Profil).
# STRICT_AGGREGATE_RISK=true
# Cap für das Aggregat-Risiko in % des Equity, falls STRICT_AGGREGATE_RISK
# aktiv ist. Finite, 0 < Wert <= 100.
# AGGREGATE_POS_RISK_CAP_PCT=2.0
# Manueller Trigger-Mode (Entry ohne Börsen-SL/TP). false = fail-closed blocken.
ALLOW_MANUAL_TRIGGER=false
# SL-Verify nach dem Platzieren (Börse spiegelt Trigger verzögert).
SL_VERIFY_ATTEMPTS=3
SL_VERIFY_DELAY_S=0.7
# Hyperliquid coins: BTC, ETH, SOL — MEXC: BTC_USDT
DEFAULT_SYMBOL=BTC
PREVIEW_TOKEN_TTL_SECONDS=60
DATABASE_PATH=data/trader.db
TRADING_ENABLED=false
ALLOW_UNPROTECTED_ENTRY=false
RISK_SLIPPAGE_PCT=0.05
MAX_NOTIONAL_USDT=500
MAX_PRICE_DRIFT_PCT=1.0
MARKET_ENTRY_SLIPPAGE_PCT=0.15
ALLOW_CROSS_MARGIN=false
AUTO_FLATTEN_IF_SL_UNVERIFIED=true
# Privacy: opt-in. When true, equity/available margin/open positions are
# sent to the external LLM provider as part of the analysis context.
INCLUDE_ACCOUNT_IN_LLM=false
# Markt-Scanner: billiges Modell screent Top-Coins (1 Call); Detail = LLM_PROVIDER
SCANNER_MODEL=claude-sonnet-5
SCANNER_MAX_COINS=20

KLINE_LIMIT_HINT=500

# Trade-Management-Layer: Break-even-Monitor + Alarme. Der Monitor laeuft mit dem
# Prozess; Auto-BE handelt NUR bei pro Position scharfgeschalteter Regel (opt-in
# im Dashboard), ist Hyperliquid-only und laeuft ueber den bestehenden modify-sl-
# Pfad (never-unprotected). Ohne Arming nur Alarme (Thesis-Invalidierung, Time-Stop).
TM_ENABLED=true
TM_MONITOR_INTERVAL_S=20
TM_BE_TRIGGER_R=1.0
TM_BE_FEE_RT=0.0006
TM_TIME_STOP_HOURS=4.0
TM_TIME_STOP_MIN_R=0.5
