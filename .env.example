HOST=127.0.0.1
PORT=8787

# mexc | hyperliquid
EXCHANGE=hyperliquid

# --- Hyperliquid (recommended: TESTNET first) ---
HL_TESTNET=true
HL_PRIVATE_KEY=
# Main wallet address if HL_PRIVATE_KEY is an API/agent wallet
HL_ACCOUNT_ADDRESS=
# Optional override (default from HL_TESTNET)
# HL_BASE_URL=https://api.hyperliquid-testnet.xyz

# --- MEXC (only if EXCHANGE=mexc) ---
MEXC_API_KEY=
MEXC_API_SECRET=
MEXC_BASE_URL=https://contract.mexc.com

# LLM: claude (default) | xai | openai (Codex) | ollama (lokal)
# Hot-Swap im UI möglich; das hier ist der Start-Default.
LLM_PROVIDER=claude
# Claude — https://console.anthropic.com/  (Key oft sk-ant-…)
ANTHROPIC_API_KEY=
# CLAUDE_API_KEY=   # alias für ANTHROPIC_API_KEY
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_BASE_URL=https://api.anthropic.com
# xAI Grok (LLM_PROVIDER=xai) — Modell-ID ggf. anpassen (z.B. grok-4.5 sobald verfügbar)
XAI_API_KEY=
XAI_MODEL=grok-4
XAI_BASE_URL=https://api.x.ai/v1
# OpenAI Codex (LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
OPENAI_BASE_URL=https://api.openai.com/v1
# Lokales Ollama (LLM_PROVIDER=ollama) — kein Key; Server muss laufen (ollama serve)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.1
LOCAL_API_TOKEN=
STRICT_AVAILABLE_MARGIN=true
REQUIRE_LOOPBACK_WHEN_ARMED=true
# Risiko-Profil wählt ein Preset: conservative | balanced (Default) | free.
# WICHTIG: Nur NICHT gesetzte Felder werden aus dem Preset gefüllt — jede
# hier aktive MAX_*/MIN_*/STRICT_*-Zeile ÜBERSTEUERT das Profil. Für echtes
# Profil-Umschalten die folgenden vier Zeilen auskommentiert lassen.
RISK_PROFILE=balanced
# MAX_LEVERAGE=20
# MAX_RISK_PCT=1.0
# MIN_RRR=2.0
# STRICT_RRR=true
# Harter equity-relativer Notional-Cap (Fat-Finger-Guard). 0 = aus.
MAX_NOTIONAL_PCT_OF_EQUITY=5000.0
# Manueller Trigger-Mode (Entry ohne Börsen-SL/TP). false = fail-closed blocken.
ALLOW_MANUAL_TRIGGER=true
# SL-Verify nach dem Platzieren (Börse spiegelt Trigger verzögert).
SL_VERIFY_ATTEMPTS=3
SL_VERIFY_DELAY_S=0.7
# Hyperliquid coins: BTC, ETH, SOL — MEXC: BTC_USDT
DEFAULT_SYMBOL=BTC
PREVIEW_TOKEN_TTL_SECONDS=60
DATABASE_PATH=data/trader.db
TRADING_ENABLED=false
ALLOW_UNPROTECTED_ENTRY=false
RISK_SLIPPAGE_PCT=0.05
MAX_NOTIONAL_USDT=500
MAX_PRICE_DRIFT_PCT=0.5
MARKET_ENTRY_SLIPPAGE_PCT=0.15
ALLOW_CROSS_MARGIN=false
AUTO_FLATTEN_IF_SL_UNVERIFIED=true
INCLUDE_ACCOUNT_IN_LLM=true
# Markt-Scanner: billiges Modell screent Top-Coins (1 Call); Detail = LLM_PROVIDER
SCANNER_MODEL=claude-sonnet-5
SCANNER_MAX_COINS=10

KLINE_LIMIT_HINT=500
